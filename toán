<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kết Nối Toán 2K26</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --primary:#4f46e5;--primary2:#7c3aed;--bg:#f5f7fb;
  --text:#172033;--muted:#667085;--card:#fff;--border:#e6e8ef;
}
body{font-family:Inter,Arial,sans-serif;background:var(--bg);color:var(--text)}
button,input,select{font:inherit}
.navbar{height:68px;background:#fff;border-bottom:1px solid var(--border);
display:flex;align-items:center;justify-content:space-between;padding:0 6%;
position:sticky;top:0;z-index:10}
.logo{font-weight:800;font-size:21px;color:var(--primary);cursor:pointer}
.logo span{color:var(--text)}
.navlinks{display:flex;gap:8px}
.navlinks button{border:0;background:none;padding:10px 14px;border-radius:9px;cursor:pointer;color:#475467}
.navlinks button:hover,.navlinks .active{background:#eef0ff;color:var(--primary)}
.hero{background:linear-gradient(135deg,#4f46e5,#7c3aed);color:#fff;padding:65px 6% 70px}
.hero-inner{max-width:1100px;margin:auto;display:grid;grid-template-columns:1.4fr .8fr;gap:40px;align-items:center}
.badge{display:inline-block;background:rgba(255,255,255,.16);padding:7px 12px;border-radius:99px;font-size:13px;margin-bottom:18px}
.hero h1{font-size:46px;line-height:1.1;margin-bottom:18px}
.hero h1 span{color:#ddd6fe}
.hero p{font-size:17px;line-height:1.7;max-width:650px;color:#eee}
.hero-buttons{display:flex;gap:12px;margin-top:26px}
.btn{border:0;border-radius:10px;padding:12px 18px;cursor:pointer;font-weight:700}
.btn-white{background:#fff;color:#4f46e5}.btn-outline{background:transparent;color:#fff;border:1px solid rgba(255,255,255,.5)}
.math-card{background:#fff;color:var(--text);border-radius:20px;padding:25px;box-shadow:0 18px 50px rgba(0,0,0,.18)}
.math-card .formula{font-size:27px;text-align:center;padding:28px 10px;background:#f7f7ff;border-radius:14px;margin:15px 0}
.container{max-width:1100px;margin:auto;padding:42px 6%}
.section-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}
.section-title h2{font-size:27px}.section-title p{color:var(--muted);margin-top:5px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px;transition:.2s}
.card:hover{transform:translateY(-3px);box-shadow:0 8px 25px rgba(16,24,40,.08)}
.grade{font-size:28px;font-weight:800;color:var(--primary);margin-bottom:8px}
.card p{color:var(--muted);font-size:14px;line-height:1.5}
.card button{margin-top:15px;width:100%;padding:10px;border:0;border-radius:9px;background:#eef0ff;color:var(--primary);font-weight:700;cursor:pointer}
.features{grid-template-columns:repeat(3,1fr)}
.feature-icon{font-size:30px;margin-bottom:10px}
.searchbox{display:flex;gap:10px;margin-bottom:22px}
.searchbox input{flex:1;padding:13px 15px;border:1px solid var(--border);border-radius:10px;outline:none}
.searchbox select{padding:13px;border:1px solid var(--border);border-radius:10px;background:#fff}
.page{display:none}.page.active{display:block}
.lesson-list{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.lesson{display:flex;justify-content:space-between;gap:15px;align-items:center;background:#fff;border:1px solid var(--border);padding:18px;border-radius:13px}
.lesson strong{display:block;margin-bottom:5px}.lesson small{color:var(--muted)}
.lesson button{border:0;background:#4f46e5;color:#fff;border-radius:8px;padding:9px 13px;cursor:pointer}
.quiz-box{background:#fff;border:1px solid var(--border);padding:25px;border-radius:16px;max-width:750px}
.option{display:block;width:100%;text-align:left;background:#f7f8fc;border:1px solid var(--border);padding:13px;margin-top:10px;border-radius:9px;cursor:pointer}
.option:hover{border-color:var(--primary);background:#eef0ff}
.result{margin-top:15px;font-weight:700}
.progress{height:10px;background:#e9eaf0;border-radius:20px;overflow:hidden;margin-top:10px}
.progress div{height:100%;background:linear-gradient(90deg,#4f46e5,#7c3aed);width:65%}
footer{background:#111827;color:#cbd5e1;text-align:center;padding:28px;margin-top:20px}
@media(max-width:800px){
 .hero-inner{grid-template-columns:1fr}.hero h1{font-size:36px}
 .grid{grid-template-columns:repeat(2,1fr)}.features{grid-template-columns:1fr}
 .lesson-list{grid-template-columns:1fr}.navlinks{display:none}
}
@media(max-width:500px){.grid{grid-template-columns:1fr}.hero{padding-top:45px}.container{padding-left:5%;padding-right:5%}}
</style>
</head>
<body>

<header class="navbar">
  <div class="logo" onclick="showPage('home')">Kết Nối <span>Toán 2K26</span></div>
  <nav class="navlinks">
    <button class="active" onclick="showPage('home',this)">Trang chủ</button>
    <button onclick="showPage('lessons',this)">Bài học</button>
    <button onclick="showPage('quiz',this)">Luyện tập</button>
    <button onclick="showPage('tools',this)">Công cụ</button>
  </nav>
</header>

<main>
<section id="home" class="page active">
  <div class="hero">
    <div class="hero-inner">
      <div>
        <div class="badge">📚 TOÁN THCS • KẾT NỐI TRI THỨC • 2026</div>
        <h1>Học Toán dễ hơn<br>với <span>Kết Nối Toán</span></h1>
        <p>Công cụ học tập dành cho học sinh THCS: khám phá bài học, luyện tập, kiểm tra kiến thức và sử dụng các công cụ Toán học trong một nơi.</p>
        <div class="hero-buttons">
          <button class="btn btn-white" onclick="showPage('lessons')">Bắt đầu học →</button>
          <button class="btn btn-outline" onclick="showPage('quiz')">Làm bài tập</button>
        </div>
      </div>
      <div class="math-card">
        <b>💡 Góc Toán hôm nay</b>
        <div class="formula">a² + b² = c²</div>
        <p style="color:#667085;text-align:center">Định lý Pythagore</p>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="section-title">
      <div><h2>Chọn lớp để học</h2><p>Nội dung có thể mở rộng theo chương trình 2026.</p></div>
    </div>
    <div class="grid">
      <div class="card"><div class="grade">Lớp 6</div><p>Nền tảng Toán THCS, số học, hình học và dữ liệu.</p><button onclick="openGrade(6)">Khám phá →</button></div>
      <div class="card"><div class="grade">Lớp 7</div><p>Đại số, hình học, tỉ lệ và các bài toán thực tế.</p><button onclick="openGrade(7)">Khám phá →</button></div>
      <div class="card"><div class="grade">Lớp 8</div><p>Đa thức, phương trình, hình học và xác suất.</p><button onclick="openGrade(8)">Khám phá →</button></div>
      <div class="card"><div class="grade">Lớp 9</div><p>Ôn tập kiến thức trọng tâm và chuẩn bị lên THPT.</p><button onclick="openGrade(9)">Khám phá →</button></div>
    </div>

    <div class="section-title" style="margin-top:45px">
      <div><h2>Công cụ học tập</h2><p>Những tính năng chính của website.</p></div>
    </div>
    <div class="grid features">
      <div class="card"><div class="feature-icon">🧠</div><h3>Học theo bài</h3><p>Tra cứu bài học theo lớp và chủ đề.</p></div>
      <div class="card"><div class="feature-icon">✏️</div><h3>Luyện tập</h3><p>Làm câu hỏi và xem kết quả ngay.</p></div>
      <div class="card"><div class="feature-icon">🧮</div><h3>Công cụ Toán</h3><p>Các tiện ích hỗ trợ tính toán và học tập.</p></div>
    </div>
  </div>
</section>

<section id="lessons" class="page">
 <div class="container">
   <div class="section-title"><div><h2>📚 Kho bài học</h2><p>Chọn lớp và tìm nội dung muốn học.</p></div></div>
   <div class="searchbox">
     <input id="search" placeholder="🔎 Tìm bài học..." oninput="filterLessons()">
     <select id="gradeFilter" onchange="filterLessons()">
       <option value="all">Tất cả lớp</option><option value="6">Lớp 6</option><option value="7">Lớp 7</option><option value="8">Lớp 8</option><option value="9">Lớp 9</option>
     </select>
   </div>
   <div id="lessonList" class="lesson-list"></div>
 </div>
</section>

<section id="quiz" class="page">
 <div class="container">
   <div class="section-title"><div><h2>✏️ Luyện tập Toán</h2><p>Thử sức với các câu hỏi mẫu.</p></div></div>
   <div class="quiz-box">
     <div id="quizContent"></div>
     <button class="btn" style="background:#4f46e5;color:#fff;margin-top:18px" onclick="nextQuestion()">Câu tiếp theo →</button>
     <div id="quizResult" class="result"></div>
   </div>
 </div>
</section>

<section id="tools" class="page">
 <div class="container">
  <div class="section-title"><div><h2>🧮 Công cụ Toán</h2><p>Các tiện ích cơ bản.</p></div></div>
  <div class="grid">
   <div class="card">
    <h3>Máy tính</h3><p style="margin:10px 0">Nhập phép tính đơn giản.</p>
    <input id="calcInput" placeholder="Ví dụ: 12*5+8" style="width:100%;padding:11px;border:1px solid #ddd;border-radius:8px">
    <button onclick="calculate()" style="margin-top:10px;width:100%;padding:10px;border:0;border-radius:8px;background:#4f46e5;color:white;cursor:pointer">Tính</button>
    <div id="calcResult" style="margin-top:12px;font-weight:bold"></div>
   </div>
   <div class="card">
    <h3>Tiến độ học tập</h3><p style="margin-top:10px">Bài học đã hoàn thành</p>
    <div class="progress"><div></div></div>
    <strong style="display:block;margin-top:8px">65%</strong>
   </div>
   <div class="card">
    <h3>📐 Công thức nhanh</h3>
    <p style="margin-top:12px">Diện tích hình chữ nhật: S = a × b</p>
    <p style="margin-top:8px">Diện tích tam giác: S = a × h ÷ 2</p>
    <p style="margin-top:8px">Đường tròn: C = 2πr</p>
   </div>
  </div>
 </div>
</section>
</main>

<footer>
  <b>Kết Nối Toán 2K26</b><br>
  Công cụ học tập Toán THCS • Phiên bản giao diện mẫu
</footer>

<script>
const lessons=[
 {g:6,t:"Tập hợp các số tự nhiên",d:"Lớp 6 • Số học"},
 {g:6,t:"Phân số",d:"Lớp 6 • Số học"},
 {g:6,t:"Hình học trực quan",d:"Lớp 6 • Hình học"},
 {g:7,t:"Số hữu tỉ",d:"Lớp 7 • Đại số"},
 {g:7,t:"Tỉ lệ thức",d:"Lớp 7 • Đại số"},
 {g:7,t:"Tam giác",d:"Lớp 7 • Hình học"},
 {g:8,t:"Đa thức",d:"Lớp 8 • Đại số"},
 {g:8,t:"Phân thức đại số",d:"Lớp 8 • Đại số"},
 {g:8,t:"Định lý Pythagore",d:"Lớp 8 • Hình học"},
 {g:9,t:"Căn bậc hai",d:"Lớp 9 • Đại số"},
 {g:9,t:"Hàm số y = ax²",d:"Lớp 9 • Đại số"},
 {g:9,t:"Hệ thức lượng trong tam giác vuông",d:"Lớp 9 • Hình học"}
];

let qi=0, score=0;
const questions=[
 {q:"Kết quả của 3² + 4² là:",a:["7","12","25","49"],c:2},
 {q:"Diện tích hình chữ nhật có chiều dài 8 cm và chiều rộng 5 cm là:",a:["13 cm²","26 cm²","40 cm²","80 cm²"],c:2},
 {q:"Căn bậc hai số học của 81 là:",a:["8","9","-9","18"],c:1},
 {q:"Nếu 2x = 10 thì x bằng:",a:["2","5","8","20"],c:1}
];

function showPage(id,btn){
 document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
 document.getElementById(id).classList.add('active');
 document.querySelectorAll('.navlinks button').forEach(b=>b.classList.remove('active'));
 if(btn) btn.classList.add('active');
 window.scrollTo({top:0,behavior:'smooth'});
 if(id==='lessons') renderLessons();
 if(id==='quiz') renderQuiz();
}
function openGrade(g){
 showPage('lessons');
 document.getElementById('gradeFilter').value=g;
 renderLessons();
}
function renderLessons(){
 const list=document.getElementById('lessonList');
 list.innerHTML=lessons.map((x,i)=>`<div class="lesson" data-text="${x.t.toLowerCase()} ${x.d.toLowerCase()}">
 <div><strong>${x.t}</strong><small>${x.d}</small></div>
 <button onclick="alert('Bạn đang mở bài: ${x.t}')">Học bài</button></div>`).join('');
 filterLessons();
}
function filterLessons(){
 const q=document.getElementById('search').value.toLowerCase();
 const g=document.getElementById('gradeFilter').value;
 document.querySelectorAll('.lesson').forEach((el,i)=>{
   const x=lessons[i];
   el.style.display=((g==='all'||String(x.g)===g)&&(x.t.toLowerCase().includes(q)||x.d.toLowerCase().includes(q)))?'flex':'none';
 });
}
function renderQuiz(){
 const x=questions[qi];
 document.getElementById('quizContent').innerHTML=`<p style="color:#667085;margin-bottom:8px">Câu ${qi+1}/${questions.length}</p><h3>${x.q}</h3>`+
 x.a.map((o,i)=>`<button class="option" onclick="answer(${i})">${String.fromCharCode(65+i)}. ${o}</button>`).join('');
 document.getElementById('quizResult').textContent='';
}
function answer(i){
 const x=questions[qi];
 document.getElementById('quizResult').textContent=i===x.c?'✅ Chính xác!':'❌ Chưa đúng, hãy xem lại kiến thức.';
 if(i===x.c) score++;
}
function nextQuestion(){
 qi=(qi+1)%questions.length;
 if(qi===0) document.getElementById('quizResult').textContent='🎉 Bạn đã hoàn thành một vòng! Điểm: '+score+'/'+questions.length;
 renderQuiz();
}
function calculate(){
 const v=document.getElementById('calcInput').value;
 try{
   if(!/^[0-9+*/().% -]+$/.test(v)) throw Error();
   document.getElementById('calcResult').textContent='= '+Function('"use strict";return ('+v+')')();
 }catch(e){document.getElementById('calcResult').textContent='Phép tính không hợp lệ.'}
}
renderLessons();renderQuiz();
</script>
</body>
</html>
